<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Block SBM Report</title>
  <link rel="stylesheet" href="block-report.css">
  <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+Devanagari:wght@400;600;700&family=Poppins:wght@400;600;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- SCREEN HEADER -->
  <div class="header no-print">
    <div class="header-left">
      <div class="header-title">📊 Block SBM Report</div>
      <div class="header-sub">Swachh Bharat Mission (Gramin) — Block Level Summary</div>
    </div>
    <div class="header-right">
      <a href="index.html" class="btn btn-back">← GP Report</a>
      <button id="btnLoad" class="btn btn-load" onclick="BlockReport.load()">☁️ डेटा लोड करें</button>
      <button id="btnPDF" class="btn btn-pdf" onclick="BlockReport.downloadPDF()" disabled>⬇️ PDF डाउनलोड</button>
    </div>
  </div>

  <!-- STATUS BAR -->
  <div class="status-bar no-print">
    <span id="statusMsg" class="status-pill">डेटा लोड होने की प्रतीक्षा करें…</span>
    <span id="pdfNameBadge" class="pdf-name-badge" style="display:none"></span>
  </div>

  <!-- PRINT HEADER (only visible in PDF/print) -->
  <div class="print-header print-only">
    <div class="ph-title">Swachh Bharat Mission (Gramin) — Block Level Report</div>
    <div class="ph-meta">
      <span id="printPdfName"></span>
      <span id="printDate"></span>
    </div>
  </div>

  <!-- SHEET TABS (screen only) -->
  <div id="sheetTabs" class="sheet-tabs no-print" style="display:none"></div>

  <!-- REPORT CONTENT -->
  <div id="reportContent" class="report-content">
    <div class="placeholder">
      <div class="placeholder-icon">📋</div>
      <div class="placeholder-text">डेटा लोड करने के लिए ऊपर "डेटा लोड करें" बटन दबाएं</div>
    </div>
  </div>

  <!-- LOADING OVERLAY -->
  <div id="loadingOverlay" class="loading-overlay" style="display:none">
    <div class="loading-box">
      <div class="spinner"></div>
      <div id="loadingMsg" class="loading-msg">डेटा लोड हो रहा है…</div>
    </div>
  </div>

  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <script src="block-report.js"></script>
  <script>
    window.addEventListener('load', () => BlockReport.load());
  </script>
</body>
</html>
