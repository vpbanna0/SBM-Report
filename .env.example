ONEDRIVE_URL=https://onedrive.live.com/your-hidden-share-link
ONEDRIVE_CACHE_TTL_MS=300000
PORT=5000

# Block PDF generation:
# auto = Excel Online/Microsoft Graph if credentials are present, otherwise LibreOffice fallback
# graph = require Excel Online/Microsoft Graph, fail if credentials/export fail
# libreoffice = force old local LibreOffice rendering
PDF_ENGINE=auto

# Option A: short-lived delegated token
GRAPH_ACCESS_TOKEN=

# Option B: refresh-token flow for GitHub Actions secrets
MS_GRAPH_TENANT=common
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_REFRESH_TOKEN=
MS_GRAPH_SCOPES=https://graph.microsoft.com/Files.ReadWrite offline_access
